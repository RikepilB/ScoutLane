# ─── ScoutLane Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public"

# ── Auth (NextAuth.js v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Google OAuth credentials. See docs/SETUP.md for the full setup walkthrough.
# Quick version:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID, type = "Web application".
#   3. Authorized JavaScript origins:  $NEXT_PUBLIC_APP_URL (e.g. http://localhost:3000)
#   4. Authorized redirect URIs:       $NEXT_PUBLIC_APP_URL/api/auth/callback/google
#
# Canonical names: AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET (preferred by NextAuth v5).
# Fallback names: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (also recognized).
# When neither is set, the dev-only Credentials provider is available for local
# sign-in with any email address. In production, set at least one pair so the
# dev provider is suppressed and only Google OAuth is accepted.
#
# GOOGLE_CLIENT_ID=""    # ← fallback name (recognized if AUTH_GOOGLE_ID is empty)
# GOOGLE_CLIENT_SECRET=""# ← fallback name (recognized if AUTH_GOOGLE_SECRET is empty)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin user email (auto-granted ADMIN role on first login)
INITIAL_ADMIN_EMAIL="admin@scoutlane.local"

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for emails, redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resume parsing strategy. Defaults to "queue-and-inline".
#  "queue-and-inline" — parse immediately during submission AND enqueue for redundancy (best dev UX)
#  "inline"           — parse synchronously during submission (blocks the response)
#  "queue"            — enqueue only; requires `pnpm worker:resume` running separately
RESUME_PARSE_MODE="queue-and-inline"

# ── File Storage (Google Cloud Storage) ──────────────────────────────────────
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# and grant the Storage Object Admin role on the bucket.
GCS_PROJECT_ID=""
GCS_BUCKET="scoutlane-uploads"
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
GCS_PUBLIC_BASE_URL=""

# Alternative: S3-compatible storage (AWS S3, Cloudflare R2, etc.).
# Used when the GCS variables above are not configured.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_PUBLIC_BASE_URL=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Required for sending applicant confirmations, status-change emails, and
# admin notifications. If RESEND_API_KEY is missing the app keeps working —
# emails are skipped and logged to the EmailLog table with status=0 and
# error="SKIPPED: ...". See docs/SETUP.md for the full procurement guide.
#
# 1. Sign up at https://resend.com (free tier OK).
# 2. Create an API key at https://resend.com/api-keys (re_...).
# 3. For local development: use the Resend shared domain (no DNS setup needed).
#    Limitation — free tier only delivers to your own Resend account email.
#    Production: verify your own domain at https://resend.com/domains.
# 4. Set EMAIL_FROM to the chosen sender address.
RESEND_API_KEY=""
EMAIL_FROM="ScoutLane <onboarding@resend.dev>"

# ── LLM Provider (OpenRouter) ───────────────────────────────────────────────
# Single gateway for Claude / Gemini / Llama / DeepSeek / etc.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model identifier. `openrouter/auto` keeps parsing available if a provider model is removed.
OPENROUTER_MODEL="openrouter/owl-alpha"
OPENROUTER_FALLBACK_MODELS="openrouter/free,openrouter/auto"

# Attribution headers (optional, but help with OpenRouter rate-limit visibility)
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_TITLE="ScoutLane"
