# ─── ScoutLane Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public"

# ── Auth (NextAuth.js v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin user email (auto-granted ADMIN role on first login)
INITIAL_ADMIN_EMAIL="admin@scoutlane.local"

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for emails, redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── File Storage (Google Cloud Storage) ──────────────────────────────────────
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# and grant the Storage Object Admin role on the bucket.
GCS_PROJECT_ID=""
GCS_BUCKET="scoutlane-uploads"
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
GCS_PUBLIC_BASE_URL=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Create an API key at https://resend.com/api-keys and verify a sending domain.
RESEND_API_KEY=""
EMAIL_FROM="noreply@scoutlane.local"

# ── LLM Provider (OpenRouter) ───────────────────────────────────────────────
# Single gateway for Claude / Gemini / Llama / DeepSeek / etc.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model identifier. Free tier examples (50 req/day cap):
#   deepseek/deepseek-chat-v3.1:free        (recommended — strong JSON output)
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
# Paid models (per-token): google/gemini-2.5-flash, anthropic/claude-3.5-haiku, etc.
OPENROUTER_MODEL="deepseek/deepseek-chat-v3.1:free"

# Attribution headers (optional, but help with OpenRouter rate-limit visibility)
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_TITLE="ScoutLane"
