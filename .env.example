# Environment Variables Template
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public&pgbouncer=true&connect_timeout=15"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="your-auth-secret-here"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
INITIAL_ADMIN_EMAIL="admin@example.com"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="scoutlane-bucket"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_BASE_URL="http://localhost:9000/scoutlane-bucket"
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="onboarding@resend.dev"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"
INTEGRATION_KEY_SECRET="your-32-byte-base64-key"
SENTRY_DSN="your-sentry-dsn"
