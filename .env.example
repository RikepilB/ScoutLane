# ─── ScoutLane Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public"

# Direct connection for connection-pooling tools (PGBouncer, etc.)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public&connect_timeout=15"

# ── Auth (NextAuth.js v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin user email (auto-seeded when no users exist)
INITIAL_ADMIN_EMAIL="admin@scoutlane.local"

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for emails, redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── File Storage (Cloudflare R2 / S3-compatible) ────────────────────────────
# Endpoint, e.g. https://ACCOUNT.r2.cloudflarestorage.com
GCS_PROJECT_ID=""
GCS_BUCKET="scoutlane-uploads"
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
GCS_PUBLIC_BASE_URL=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@scoutlane.local"

# ── LLM Providers (at least one required for AI features) ────────────────────
# Google Gemini 2.5 Flash
GEMINI_API_KEY=""
# OpenAI GPT-4o Mini (alternative)
OPENAI_API_KEY=""

# ── Background Jobs (Inngest) ───────────────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Security ─────────────────────────────────────────────────────────────────
# 32-byte key base64-encoded for AES-256 webhook payload encryption
# Generate with: openssl rand -base64 32
INTEGRATION_KEY_SECRET=""

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=""
