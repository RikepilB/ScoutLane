# ─── ScoutLane Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public"

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Create an application at https://dashboard.clerk.com
# Enable Organizations only if you later need multi-tenant Clerk orgs (ScoutLane
# uses its own Postgres Organization model + Prisma User.role for RBAC).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Webhook signing secret (Dashboard → Webhooks → endpoint → Signing secret).
# Subscribe to user.created and user.updated; point the endpoint at:
#   $NEXT_PUBLIC_APP_URL/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=""

# First admin user email (auto-granted ADMIN role on first Clerk sign-in sync)
INITIAL_ADMIN_EMAIL="admin@scoutlane.local"

# Demo one-click login (landing + /signin): create matching users in Clerk Dashboard
# with the same emails as prisma/seed.ts — admin, recruiter@scoutlane.local, guest@scoutlane.local

# ── Legacy (removed — NextAuth no longer used) ───────────────────────────────
# AUTH_SECRET, AUTH_GOOGLE_*, AUTH_ALLOWED_EMAIL_DOMAIN, ALLOW_DEV_LOGIN

# Public URL of the deployed app (used for emails, redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resume parsing strategy. Defaults to "queue" (async; applicant never waits).
#  "queue"            — dispatch via the job runner below (recommended)
#  "queue-and-inline" — dispatch AND parse immediately during submission (redundant)
#  "inline"           — parse synchronously during submission (blocks the response)
RESUME_PARSE_MODE="queue"

# Background job runner for resume parsing + email delivery.
#  "worker" — enqueue to pg-boss; requires `pnpm worker:resume` and `pnpm worker:emails`
#             running on a long-lived host (Railway/Render/Fly). Default off Vercel.
#  "inline" — run after the response in the same serverless invocation via next/server
#             after(); no worker needed. Default on Vercel.
JOB_RUNNER=""

# Dev-login escape hatch for local production-build smoke tests ONLY.
# The dev provider grants ADMIN to any email -- NEVER set this on a deployed
# environment. Dev login is otherwise enabled only under `next dev`.
ALLOW_DEV_LOGIN=""

# Encryption key for persisted integration API keys and webhook signing secrets.
# Required before creating integrations or running `pnpm db:encrypt-integration-secrets`.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# For a safe rotation: set PREVIOUS to the existing key, set this variable to a new
# key, deploy, run `pnpm db:encrypt-integration-secrets`, then remove PREVIOUS only
# after the command succeeds against every database.
INTEGRATION_SECRETS_ENCRYPTION_KEY=""
INTEGRATION_SECRETS_PREVIOUS_ENCRYPTION_KEY=""

# ── File Storage (Google Cloud Storage) ──────────────────────────────────────
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# and grant the Storage Object Admin role on the bucket.
GCS_PROJECT_ID=""
GCS_BUCKET="scoutlane-uploads"
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
GCS_PUBLIC_BASE_URL=""

# Alternative: S3-compatible storage (AWS S3, Cloudflare R2, etc.).
# Used when the GCS variables above are not configured.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_PUBLIC_BASE_URL=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Required for sending applicant confirmations, status-change emails, and
# admin notifications. If RESEND_API_KEY is missing the app keeps working —
# emails are skipped and logged to the EmailLog table with status=0 and
# error="SKIPPED: ...". See docs/SETUP.md for the full procurement guide.
#
# 1. Sign up at https://resend.com (free tier OK).
# 2. Create an API key at https://resend.com/api-keys (re_...).
# 3. For local development: use the Resend shared domain (no DNS setup needed).
#    Limitation — free tier only delivers to your own Resend account email.
#    Production: verify your own domain at https://resend.com/domains.
# 4. Set EMAIL_FROM to the chosen sender address.
RESEND_API_KEY=""
EMAIL_FROM="ScoutLane <onboarding@resend.dev>"

# ── LLM Provider (OpenRouter) ───────────────────────────────────────────────
# Single gateway for Claude / Gemini / Llama / DeepSeek / etc.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model identifier. Defaults to google/gemini-2.5-flash when unset.
# `openrouter/auto` keeps parsing available if a provider model is removed.
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_FALLBACK_MODELS="google/gemini-2.5-flash-lite,openrouter/auto"

# Attribution headers (optional, but help with OpenRouter rate-limit visibility)
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_TITLE="ScoutLane"
