{
  "name": "ScoutLane",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/postgres:1": {
      "version": "16"
    },
    "ghcr.io/devcontainers-extra/features/pnpm:2": {}
  },
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public",
    "DIRECT_URL": "postgresql://postgres:postgres@localhost:5432/scoutlane?schema=public",
    "NEXT_PUBLIC_APP_URL": "http://localhost:3000",
    "AUTH_SECRET": "dev-auth-secret-change-in-production"
  },
  "postCreateCommand": "cp -n .env.example .env || true && pnpm install --no-frozen-lockfile && pnpm prisma generate",
  "postStartCommand": "pnpm prisma migrate deploy || pnpm prisma migrate dev --name init && pnpm db:seed",
  "forwardPorts": [3000, 5432],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Prisma.prisma"
      ]
    }
  }
}
