generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECRUITER
  HIRING_MANAGER
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  jobs      Job[]
  templates JobTemplate[]
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole      @default(RECRUITER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  accounts    Account[]
  sessions    Session[]
  jobsCreated Job[]
  templatesCreated JobTemplate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id             String        @id @default(cuid())
  title          String
  description    String?
  location       String?
  type           String?
  salary         String?
  slug           String        @unique
  published      Boolean       @default(false)
  archived       Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customFields Json?
  applicants   Applicant[]
  stages       PipelineStage[]
}

model JobTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  title          String
  jobDescription String?
  location       String?
  type           String?
  salary         String?
  stageNames     String[]
  questions      Json?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model Applicant {
  id        String            @id @default(cuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  resumeUrl String?
  status    ApplicationStatus @default(NEW)
  score     Float?
  notes     String?
  data      Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([jobId, email])
}

model PipelineStage {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String?
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs WebhookLog[]
}

model WebhookLog {
  id        String   @id @default(cuid())
  webhookId String
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event     String
  status    Int
  request   String?
  response  String?
  createdAt DateTime @default(now())
}
