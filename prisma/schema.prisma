generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECRUITER
  HIRING_MANAGER
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum ParsingStatus {
  PENDING
  PARSING
  COMPLETED
  FAILED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  jobs      Job[]
  templates JobTemplate[]
}

model User {
  id             String        @id @default(cuid())
  name           String?
  phone          String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole      @default(RECRUITER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  accounts         Account[]
  sessions         Session[]
  jobsCreated      Job[]
  templatesCreated JobTemplate[]
  stageTransitions StageTransition[]
  applicantNotes   ApplicantNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id             String        @id @default(cuid())
  title          String
  description    String?
  location       String?
  type           String?
  salary         String?
  slug           String        @unique
  published      Boolean       @default(false)
  archived       Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// Snapshot from applied template at job creation — used for integration assessment payloads
  assessmentTitle     String?
  assessmentQuestions Json?
  customFields        Json?
  applicants          Applicant[]
  stages              PipelineStage[]
  integrations        JobIntegration[]
  stageTransitions    StageTransition[]
}

model JobTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  title          String
  jobDescription String?
  location       String?
  type           String?
  salary         String?
  stageNames     String[]
  questions      Json?
  customFields   Json?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model Applicant {
  id                 String            @id @default(cuid())
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pipelineStageId    String?
  pipelineStage      PipelineStage?    @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  lastStageChangeAt  DateTime          @default(now())
  name               String
  email              String?
  phone              String?
  resumeUrl          String?
  status             ApplicationStatus @default(NEW)
  score              Float?
  notes              String?
  data               Json?
  parsedData         Json?
  parsingStatus      ParsingStatus?    @default(PENDING)
  interviewDate      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  transitions StageTransition[]
  noteEntries ApplicantNote[]

  @@unique([jobId, email])
  @@index([jobId, pipelineStageId])
  @@index([jobId, createdAt])
}

model ApplicantNote {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([applicantId])
}

model PipelineStage {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integration JobIntegration?
  applicants  Applicant[]
}

model StageTransition {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobId       String
  fromStage   String?
  toStage     String
  changedById String?
  changedBy   User?     @relation(fields: [changedById], references: [id])
  createdAt   DateTime  @default(now())
  job         Job       @relation(fields: [jobId], references: [id])
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String?
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs        IntegrationLog[]
  webhookLogs WebhookLog[]
}

model JobIntegration {
  id               String        @id @default(cuid())
  jobId            String
  job              Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId          String        @unique
  stage            PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  endpointUrl      String
  apiKey           String
  includeQuestions Boolean       @default(false)
  active           Boolean       @default(true)
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  failureCount     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  logs IntegrationLog[]
}

model WebhookLog {
  id        String   @id @default(cuid())
  webhookId String
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event     String
  status    Int
  request   String?
  response  String?
  createdAt DateTime @default(now())
}

model IntegrationLog {
  id                  String         @id @default(cuid())
  integrationId       String
  integration         JobIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event               String
  status              Int
  requestBody         String?
  responseBody        String?
  createdAt           DateTime       @default(now())
  webhook             Webhook?       @relation(fields: [webhookId], references: [id])
  webhookId           String?
  /// Links outbound dispatch to a pipeline transition for tracing and idempotency checks
  stageTransitionId   String?

  @@index([integrationId, stageTransitionId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  status    Int
  error     String?
  createdAt DateTime @default(now())
}
